# add these lines to ~/.config/sioyek/prefs_user.config after running ./install.sh
right_click_context_menu 1

# AI actions on the selected text go to the document's chat (one ongoing chat per document, nothing is highlighted)
context_menu_items_for_selected_text add_highlight_and_copy_link(a)|show_custom_context_menu(Ask Claude, ai_explain|ai_translate|ai_summarize|ai_define|ai_ask|ai_chat)|copy|add_highlight(a)|add_highlight(b)|add_highlight(c)

# only needed if the chat is installed somewhere else
#ai_popup_command ~/.config/sioyek/bin/sioyek-ai

# and to ~/.config/sioyek/keys_user.config, to open the chat with Shift+A:
# ai_chat A
